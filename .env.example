
# Flask App Configuration
FLASK_APP=main.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Security Secrets
SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET_KEY=jwt-secret-key-change-in-production

# JWT Expiration Time (in seconds)
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# Database Configuration (MySQL)
MYSQL_DATABASE=DB_name
MYSQL_ROOT_PASSWORD=DB_ROOT_password
MYSQL_USER=root
MYSQL_PASSWORD=DB_password
MYSQL_HOST=DB_HOST
MYSQL_PORT=DB_PORT

# Database Connection URL:
DATABASE_URL=mysql+pymysql://root:password@DB_HOST:DB_PORT/DB_name
# If connecting from host to Docker MySQL port:
# DATABASE_URL=mysql+pymysql://root:root@localhost:3307/calorie_ai


# AI Services Configuration
SARVAM_API_KEY=api_key
SARVAM_AI_MODEL=model_name
SARVAM_AI_TIMEOUT=300

# Frontend API Configuration
VITE_API_BASE_URL=http://localhost:5000
