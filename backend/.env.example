FLASK_APP=main.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET_KEY=jwt-secret-key-change-in-production

JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# Local native MySQL:
DATABASE_URL=mysql+pymysql://root:passowrd@localhost:3306/db_name
# Local host connecting to Docker MySQL (port 3307):
# DATABASE_URL=mysql+pymysql://root:password@localhost:3307/db_name

SARVAM_AI_API_KEY=api_key
SARVAM_AI_MODEL=model_name
SARVAM_AI_TIMEOUT=200

# Rate Limiting Configuration (Flask-Limiter)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=memory://  # Use redis://host:6379 for production
RATE_LIMIT_DEFAULT=60 per minute; 1000 per hour
RATE_LIMIT_AUTH=5 per minute; 20 per hour
RATE_LIMIT_COMPUTE=10 per minute; 100 per hour
RATE_LIMIT_WRITE=30 per minute; 300 per hour
RATE_LIMIT_READ=60 per minute; 1000 per hour
RATE_LIMIT_ADMIN=30 per minute; 500 per hour

# Security / Protection Limits
MAX_CONTENT_LENGTH_MB=1  # Max request payload size in MB (prevents DoS)
# Security Headers Configuration
SECURITY_HEADERS_ENABLED=true
# SECURITY_CSP=default-src 'none'; frame-ancestors 'none'; form-action 'none'; base-uri 'none'
# SECURITY_HSTS_ENABLED=true
# SECURITY_HSTS=max-age=31536000; includeSubDomains; preload
# SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
# SECURITY_SERVER_HEADER=  # Leave empty to remove Server header
